# Chat key is preferred; IDRAK_API_KEY is the fallback.
IDRAK_CHAT_API_KEY=
IDRAK_API_KEY=
# Legacy agent credentials are not used by the current chat/LiveKit flow.
IDRAK_AGENT_ID=agt-1791273705542-awzfqk
IDRAK_AGENT_KEY=
